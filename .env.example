API_KEY=
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PersonaEmp Exp1 generation. Keep real keys in a local .env or process
# environment; never commit them.
PERSONAEMP_GENERATOR_API_KEY=
PERSONAEMP_GENERATOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PERSONAEMP_GENERATOR_MODEL=qwen3-30b-a3b-instruct-2507
PERSONAEMP_GENERATOR_ENABLE_THINKING=false
PERSONAEMP_GENERATOR_TIMEOUT_SECONDS=180
PERSONAEMP_GENERATOR_MAX_ATTEMPTS=6

# PersonaEmp fixed-criteria generation. Leave unset until the paper-specified
# DeepSeek stage is enabled.
PERSONAEMP_CRITERIA_API_KEY=
PERSONAEMP_CRITERIA_BASE_URL=
PERSONAEMP_CRITERIA_MODEL=deepseek-v4-flash

# PersonaEmp Qwen judge.
PERSONAEMP_QWEN_JUDGE_API_KEY=
PERSONAEMP_QWEN_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PERSONAEMP_QWEN_JUDGE_MODEL=qwen3-30b-a3b-instruct-2507

# PersonaEmp DeepSeek judge (deferred).
PERSONAEMP_DEEPSEEK_JUDGE_API_KEY=
PERSONAEMP_DEEPSEEK_JUDGE_BASE_URL=
PERSONAEMP_DEEPSEEK_JUDGE_MODEL=deepseek-v4-flash
